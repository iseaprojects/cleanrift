<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>cleanrift</id>
    <version>1.0.0-beta3.1</version>
    <title>CleanRift</title>
    <authors>CleanRift contributors</authors>
    <projectUrl>https://github.com/iseaprojects/cleanrift</projectUrl>
    <projectSourceUrl>https://github.com/iseaprojects/cleanrift</projectSourceUrl>
    <packageSourceUrl>https://github.com/iseaprojects/cleanrift/tree/main/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://github.com/iseaprojects/cleanrift#readme</docsUrl>
    <bugTrackerUrl>https://github.com/iseaprojects/cleanrift/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/iseaprojects/cleanrift/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Open-source Windows uninstaller with quarantine and undo.</summary>
    <description>CleanRift is an open-source Windows uninstaller. It runs a program's own uninstaller, reviews leftover files and registry entries, keeps removed content in quarantine for undo, can create a System Restore point, traces new installations with real-time filesystem and ETW registry events, and manages startup items. It is portable, has no ads or telemetry, and is available in six languages.</description>
    <releaseNotes>Patch release with dependency updates only. See https://github.com/iseaprojects/cleanrift/releases/tag/v1.0.0-beta.3.1</releaseNotes>
    <copyright>Copyright (c) 2026 CleanRift contributors</copyright>
    <tags>cleanrift uninstaller windows cleanup quarantine open-source portable</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
